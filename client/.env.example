# Optional. The client calls the API at the same origin (`/api`) by default,
# which Vite proxies to the server in development — so the browser makes no
# cross-origin request and the server needs no CORS layer. Set this only for a
# split deployment where the API lives on a different host.
# VITE_API_BASE_URL=https://api.example.com/api

# Optional. Without these the app runs in demo mode: no sign-in, example data.
# Only the public anon key belongs here — never a service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
