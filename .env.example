# Template. Copy to .env at the repo root and fill in the values.
# Never put a real key in this file — it is committed. .env is gitignored.
# A server/.env still wins over the root .env if one exists.

PORT=3000
ANTHROPIC_API_KEY=

# Supabase. Required — the server will not start without these. There is no
# in-memory fallback, because a server that boots without a database would
# accept analyses, pay for them and drop them.
#
# The project needs asymmetric JWT signing keys enabled (Auth -> JWT Keys).
# That is what lets the server verify a token against cached public keys
# in-process, instead of calling Supabase on every single request.
SUPABASE_URL=

# The publishable (anon) key, and deliberately nothing else. The server acts as
# the signed-in user and lets row-level security do the isolating; a
# service_role key would bypass every policy in the migration and make that
# guarantee depend on no repository ever forgetting a filter.
SUPABASE_PUBLISHABLE_KEY=

# These two are all the Supabase config there is. The browser needs the same
# pair, and gets them from here: vite.config.ts injects them at build time
# rather than requiring a second, VITE_-prefixed copy of each value. Leaving
# them unset is a supported state — the client then runs in demo mode with
# example data and no sign-in, though the server will refuse to start.

# Optional, and not the happy path. The client calls the API at the same origin
# (`/api`) by default, which Vite proxies to the server in development, so the
# browser makes no cross-origin request and the server needs no CORS layer. Set
# this only for a split deployment where the API lives on another host — an
# absolute http://localhost:3000 here would make every request cross-origin
# and fail.
# VITE_API_BASE_URL=https://api.example.com/api
