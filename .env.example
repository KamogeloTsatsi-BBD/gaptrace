# Template. Copy to .env at the repo root and fill in the values.
# Never put a real key in this file — it is committed. .env is gitignored.
# A server/.env still wins over the root .env if one exists.

PORT=3000
ANTHROPIC_API_KEY=

# Unused for now — nothing touches Supabase yet.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
